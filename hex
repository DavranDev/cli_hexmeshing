#!/usr/bin/env bash
# Launch the hex application with the CUDA 12.4 runtime it was built against.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${HEX_IMAGE:-hexmesh-cli:latest}"

BINARY="$ROOT/interactive-hex-meshing/bin/Release/hex"
CALLER_PWD="$PWD"

args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ "${args[$i]}" == "--script" ]]; then
    if ((i + 1 >= ${#args[@]})); then
      echo "ERROR: --script requires a YAML file." >&2
      exit 2
    fi
    if [[ "${args[$((i + 1))]}" != /* ]]; then
      args[$((i + 1))]="$CALLER_PWD/${args[$((i + 1))]}"
    fi
  fi
done

set +u
# shellcheck disable=SC1091
source "$ROOT/lib/vulkan-sdk-1.3.268.0/setup-env.sh"
set -u
export LD_LIBRARY_PATH="$ROOT/lib/libtorch/lib:$VULKAN_SDK/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [[ -f /usr/share/vulkan/icd.d/nvidia_icd.json ]]; then
  export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
fi

# Prefer the faster native executable when all libraries resolve and it was
# built with host asset paths. Set HEX_DOCKER=1 to force the container fallback.
if [[ "${HEX_DOCKER:-0}" != "1" ]] &&
   ! ldd "$BINARY" 2>/dev/null | grep 'not found' >/dev/null &&
   ! strings "$BINARY" | grep -F '/space/interactive-hex-meshing/vkoo/assets' >/dev/null; then
  cd "$(dirname "$BINARY")"
  exec ./hex "${args[@]}"
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "ERROR: Docker image '$IMAGE' is not available." >&2
  echo "Build it with: docker build -f Dockerfile.build --target build -t hexmesh-cli:latest ." >&2
  exit 1
fi

needs_display=1
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --headless|-h|--help)
      needs_display=0
      ;;
  esac
done

docker_args=(
  run --rm --gpus all
  --user "$(id -u):$(id -g)"
  -e HOME=/tmp
  -e NVIDIA_DRIVER_CAPABILITIES=all
  -v "$ROOT:$ROOT"
  -v "$ROOT/output:/space/output"
  -w /space/interactive-hex-meshing/bin/Release
)

if ((needs_display)); then
  if [[ -z "${DISPLAY:-}" ]]; then
    echo "ERROR: DISPLAY is unset. Use --headless with --script, or run from an X11 session." >&2
    exit 1
  fi
  docker_args+=(
    -e "DISPLAY=$DISPLAY"
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw
  )
fi

docker "${docker_args[@]}" "$IMAGE" ./hex "${args[@]}"
