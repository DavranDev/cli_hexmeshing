#!/usr/bin/env bash
# Launch the hex application with the CUDA 12.4 runtime it was built against.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Variant-aware docker/Vulkan/LibTorch wiring lives in one place.
# HEX_IMAGE_VARIANT=cpu selects the CUDA-free build; it is independent of the
# `--device cpu|cuda` flag forwarded to the binary.
# shellcheck source=cli_run/lib/docker_args.sh
source "$ROOT/cli_run/lib/docker_args.sh"
HEX_VARIANT="$(hexmesh_variant)"
HEX_RENDERER_SEL="$(hexmesh_renderer)"

IMAGE="${HEX_IMAGE:-$(hexmesh_image cli)}"

BINARY="$ROOT/interactive-hex-meshing/bin/Release/hex"
CALLER_PWD="$PWD"

args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ "${args[$i]}" == "--script" ]]; then
    if ((i + 1 >= ${#args[@]})); then
      echo "ERROR: --script requires a YAML file." >&2
      exit 2
    fi
    if [[ "${args[$((i + 1))]}" != /* ]]; then
      args[$((i + 1))]="$CALLER_PWD/${args[$((i + 1))]}"
    fi
  fi
done

set +u
# shellcheck disable=SC1091
# A CPU-only install has no LunarG SDK at all — it uses the distro Vulkan loader
# — so the missing-SDK hard error applies to the CUDA variant only.
# A renderer-free build links no Vulkan at all, so the missing-SDK hard error
# must not fire for it either -- same reasoning as the CPU variant below.
if [[ "$HEX_VARIANT" == cuda && "$HEX_RENDERER_SEL" == vulkan ]]; then
  if [[ -f "$ROOT/lib/vulkan-sdk/setup-env.sh" ]]; then
    source "$ROOT/lib/vulkan-sdk/setup-env.sh"
  elif [[ -f "$ROOT/lib/vulkan-sdk-1.3.268.0/setup-env.sh" ]]; then
    source "$ROOT/lib/vulkan-sdk-1.3.268.0/setup-env.sh"
  else
    echo "ERROR: Vulkan SDK not found under $ROOT/lib/vulkan-sdk" >&2
    exit 1
  fi
fi
set -u
export LD_LIBRARY_PATH="$(hexmesh_ld_library_path "$ROOT")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [[ "$HEX_VARIANT" == cuda && "$HEX_RENDERER_SEL" == vulkan \
      && -f /usr/share/vulkan/icd.d/nvidia_icd.json ]]; then
  export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
fi

# Prefer the faster native executable when all libraries resolve and it was
# built with host asset paths. Set HEX_DOCKER=1 to force the container fallback.
if [[ "${HEX_DOCKER:-0}" != "1" ]] &&
   ! ldd "$BINARY" 2>/dev/null | grep 'not found' >/dev/null &&
   ! strings "$BINARY" | grep -F '/space/interactive-hex-meshing/vkoo/assets' >/dev/null; then
  # Both variants build into bin/Release, so make sure this binary is the one
  # the requested variant expects before running it.
  hexmesh_check_binary_variant "$(dirname "$BINARY")" || exit 1
  cd "$(dirname "$BINARY")"
  exec ./hex "${args[@]}"
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "ERROR: Docker image '$IMAGE' is not available." >&2
  if [[ "$HEX_VARIANT:$HEX_RENDERER_SEL" == cpu:vulkan ]]; then
    echo "Build it with: docker build -f Dockerfile.cpu --target runtime -t hexmesh-cpu:latest ." >&2
  elif [[ "$HEX_VARIANT:$HEX_RENDERER_SEL" == cpu:none ]]; then
    echo "Build it with: docker build -f Dockerfile.novk --target runtime -t hexmesh-novk:latest ." >&2
  elif [[ "$HEX_VARIANT:$HEX_RENDERER_SEL" == cuda:none ]]; then
    echo "Build it with: docker build -f Dockerfile.cuda-novk --target runtime -t hexmesh-cuda-novk:latest ." >&2
  else
    echo "Build it with: docker build -f Dockerfile.build --target build -t hexmesh-cli:latest ." >&2
  fi
  exit 1
fi

# --no-vulkan implies --headless inside the binary, so it must imply "no display
# needed" here too; otherwise this wrapper demands an X11 DISPLAY for a run that
# never opens a window.
if [[ "$HEX_RENDERER_SEL" == none ]]; then
  needs_display=0
else
  needs_display=1
fi
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --headless|--no-vulkan|-h|--help)
      needs_display=0
      ;;
  esac
done

hexmesh_runtime_docker_args
docker_args=(
  run --rm
  "${HEXMESH_DOCKER_ARGS[@]}"
  --user "$(id -u):$(id -g)"
  -e HOME=/tmp
  -v "$ROOT:$ROOT"
  -v "$ROOT/output:/space/output"
  -w /space/interactive-hex-meshing/bin/Release
)

if ((needs_display)); then
  if [[ -z "${DISPLAY:-}" ]]; then
    echo "ERROR: DISPLAY is unset. Use --headless with --script, or run from an X11 session." >&2
    exit 1
  fi
  docker_args+=(
    -e "DISPLAY=$DISPLAY"
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw
  )
fi

docker "${docker_args[@]}" "$IMAGE" ./hex "${args[@]}"
