# Dockerfile.build — self-contained, one-step build of the CLI hex-meshing tool.
# ============================================================================
# Unlike the env-only `Dockerfile` (which only installs deps and expects the
# source to be bind-mounted + `compile.sh` run by hand via run_docker.sh), this
# Dockerfile COPYs the source from the build context and compiles `hex` +
# evocube *inside* the image. The result is a ready-to-run image — no host mount,
# no manual compile step.
#
# Build:
#   docker build -f Dockerfile.build -t hexmesh-cli:week2 .
# Run the smoke test (needs an NVIDIA GPU + driver + X11 at RUN time only):
#   docker run --runtime=nvidia --gpus all --rm \
#     -e DISPLAY -e HEX_LOCAL=1 \
#     -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
#     -v /usr/share/vulkan:/usr/share/vulkan:ro \
#     -v "$(pwd)/output:/space/output" \
#     hexmesh-cli:week2 ./cli_run/smoke_test.sh
#
# GPU note: the GPU is NOT needed to BUILD (nvcc compiles without a device).
# A GPU + Vulkan + an X11 display are needed only at `docker run` time.
#
# Source strategy: we COPY the checked-out source (matches the exact commit under
# test, and the forks may need auth — we never bake a token into a layer). The
# documented alternative is `git clone` of the public repo inside the build.
# Library strategy: we COPY the already-downloaded archives that setup.sh placed
# at the repo root and extract them in a throwaway stage, so the ~2.9 GB archives
# never bloat a layer in the final image. Documented fallback: wget them (see the
# commented lines in the `libs` stage).
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1: unpack the big library archives once. This stage is discarded, so the
# archives themselves never end up in the final image's layers.
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS libs

RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /space/lib

# LibTorch: COPY the (correct, ~2.6 GB) archive from the build context to avoid a
# large re-download. It extracts to ./libtorch.
COPY libtorch-cxx11-abi-shared-with-deps-2.6.0+cu124.zip /tmp/libtorch.zip
RUN unzip -q /tmp/libtorch.zip -d /space/lib && rm /tmp/libtorch.zip

# Vulkan SDK: use the PROVEN 1.3.268.0 — the version compile.sh + run.sh + the
# docker-hexmesh image were validated against.
# NOTE: the repo-root `vulkansdk.tar.xz` is a DIFFERENT, untested version
# (1.4.341.1) and is deliberately NOT used. This archive is repackaged from the
# proven lib/vulkan-sdk-1.3.268.0 tree; its top-level dir is already
# `vulkan-sdk-1.3.268.0`, so no rename is needed.
# (LunarG's direct download link for 1.3.268.0 now 404s, so we don't wget it.)
COPY vulkan-sdk-1.3.268.0.tar.xz /tmp/vulkan-sdk.tar.xz
RUN tar -xf /tmp/vulkan-sdk.tar.xz -C /space/lib && rm /tmp/vulkan-sdk.tar.xz

# ---------------------------------------------------------------------------
# Stage 2: the build + final image. Same proven base + apt/pip deps as the
# env-only Dockerfile (kept identical on purpose).
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

WORKDIR /space

# --- system + python dependencies (identical to the proven `Dockerfile`) ---
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git cmake build-essential python3 python3-pip \
      libblas-dev liblapack-dev libgl1-mesa-dev \
      libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
      libhdf5-serial-dev vulkan-tools \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy meshio open3d h5py

# --- libraries (extracted in stage 1, copied without the raw archives) ---
COPY --from=libs /space/lib /space/lib

# --- source from the build context (NOT bind-mounted) ---
# evocube + the CDM source + the build script + the CLI wrapper. The image is
# laid out at /space exactly like run_docker.sh's mounts, so compile.sh and the
# run.sh paths (/space/output/...) work unchanged.
COPY evocube/                  /space/evocube/
COPY interactive-hex-meshing/  /space/interactive-hex-meshing/
COPY compile.sh                /space/compile.sh
COPY cli_run/                  /space/cli_run/

# --- compile evocube + hex in one shot (the same script the manual flow runs) ---
# compile.sh sets Torch_DIR and sources the Vulkan setup-env.sh itself. It has no
# `set -e`, so we verify the binary afterwards and FAIL the build if it is missing
# (otherwise a compile error would silently produce a binary-less image).
RUN bash /space/compile.sh \
 && test -x /space/interactive-hex-meshing/bin/Release/hex \
 && echo "OK: hex binary built at /space/interactive-hex-meshing/bin/Release/hex"

# --- runtime environment (mirrors vulkan setup-env.sh + libtorch lib dir) so the
#     baked binary resolves its shared libs without any extra sourcing ---
ENV VULKAN_SDK=/space/lib/vulkan-sdk-1.3.268.0/x86_64
ENV PATH=$VULKAN_SDK/bin:$PATH
ENV LD_LIBRARY_PATH=/space/lib/libtorch/lib:$VULKAN_SDK/lib
ENV VK_ADD_LAYER_PATH=$VULKAN_SDK/etc/vulkan/explicit_layer.d

# output/ is created at run time by the pipeline; ensure it exists if not mounted.
RUN mkdir -p /space/output

CMD ["/bin/bash"]
