# .dockerignore for Dockerfile.build
# ----------------------------------------------------------------------------
# Goal: keep the build context to source only. Dockerfile.build downloads
# LibTorch + the current LunarG Vulkan SDK itself, so local zip/tar archives stay
# out of the build context.
# The Dockerfile.build COPYs only:
#   - evocube/  interactive-hex-meshing/  compile.sh  cli_run/  patches/
# Anything not on that list is excluded below. (See T1.1/T1.2 in week2_plan.txt.)

# --- VCS / editor / agent noise ---
.git
**/.git
.gitignore
.gitmodules
.github/
.vscode/
.claude/
.codex

# --- SECURITY: never let the GitHub token enter a build layer ---
github_token.txt

# --- Big extracted trees the image rebuilds itself; do NOT ship them raw ---
lib/                       # 5.9G of already-extracted libtorch + vulkan; the
                           # image re-extracts these from the two archives below
1.4.341.1/                 # stray extracted Vulkan SDK at the repo root (1.6G)
output/                    # runtime pipeline outputs (mounted at run time)

# --- CMake build trees + the prebuilt host binary; the image compiles fresh ---
**/build
interactive-hex-meshing/bin/

# --- libigl's download cache (evocube/lib/libigl/external/.cache): a host-specific
# build artifact. It MUST NOT be shipped: the `**/.git` rule above strips the .git
# from the cached eigen checkout, so in-image cmake's "git update" fails with
# "fatal: not a git repository" and evocube's configure dies. Excluding it makes
# libigl download eigen fresh at configure time (proven to work; matches a clean
# clone), so the build is reproducible. ---
**/.cache/

# --- Host-only helpers not needed inside the image ---
run_docker.sh
run_docker.txt
install_docker.sh
setup.sh
Dockerfile.build
.dockerignore

# --- Archives: Dockerfile.build downloads these; never ship local copies ---
*.zip
*.tar.xz
