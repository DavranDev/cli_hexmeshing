# Dockerfile.cpu — CPU-only build & runtime images. No CUDA anywhere.
# ============================================================================
# Mirrors Dockerfile.build's libs -> build -> runtime stage structure and its
# /space layout, so compile.sh, cli_run/run.sh and the rendered
# /space/output/... paths all work unchanged. The differences are deliberate
# and are the whole point of this file:
#
#   * base is plain ubuntu:22.04, not nvcr.io/nvidia/cuda — no CUDA toolkit, no
#     cuDNN, no NVIDIA packages of any kind.
#   * LibTorch is the ~200 MB "+cpu" archive, not the ~2.5 GB cu124 one.
#   * hex is compiled with HEX_ENABLE_CUDA=OFF (compile.sh reads HEX_CPU_ONLY),
#     so no CUDA headers are included and no CUDA library is linked.
#   * Vulkan comes from the distro (libvulkan-dev + mesa-vulkan-drivers), not
#     the ~1.5 GB LunarG SDK. Vulkan is a *renderer* dependency, not a GPU one:
#     hex creates a Vulkan device even headless. There are deliberately no
#     VULKAN_SDK* variables here.
#
# Two things this image does NOT change: it is still a GPU-free *build*, and
# running it needs no GPU, no NVIDIA driver and no `--gpus` flag.
#
# amd64 only. VK_ICD_FILENAMES below points at the arch-specific lavapipe ICD
# manifest name; ARM64 is out of scope rather than silently broken.
#
# Build:
#   docker build -f Dockerfile.cpu --target build   -t hexmesh-cpu:build .
#   docker build -f Dockerfile.cpu --target runtime -t hexmesh-cpu:latest .
# Run the headless CPU smoke test (no --gpus, no --runtime=nvidia):
#   docker run --rm -e HEX_LOCAL=1 -e SMOKE_DEVICE=cpu \
#     -v "$(pwd)/output:/space/output" hexmesh-cpu:latest ./cli_run/smoke_test.sh
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1 (libs): unpack the LibTorch archive once. Discarded, so the archive
# itself never lands in a shipped layer. No Vulkan SDK download at all.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS libs

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates wget unzip \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /space/lib

# These three must stay in step with setup.sh's LIBTORCH_* constants — they are
# the same contract, written twice for the two consumers (host install vs this
# image). setup.sh records them in lib/libtorch/.hexmesh-variant; so do we.
ARG LIBTORCH_VERSION=2.6.0
ARG LIBTORCH_VARIANT=cpu
ARG LIBTORCH_ABI=cxx11
ARG LIBTORCH_URL=https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.6.0%2Bcpu.zip

RUN set -eux; \
    wget -O /tmp/libtorch.zip "$LIBTORCH_URL"; \
    unzip -q /tmp/libtorch.zip -d /space/lib; \
    rm /tmp/libtorch.zip; \
    test -d /space/lib/libtorch; \
    grep -q "^${LIBTORCH_VERSION}+${LIBTORCH_VARIANT}$" /space/lib/libtorch/build-version; \
    # A cu124 archive behind a "+cpu" URL would silently reintroduce every CUDA
    # dependency this image exists to avoid, so refuse it here rather than at
    # verification time.
    if ls /space/lib/libtorch/lib | grep -Eiq 'cuda|cudnn|nvrtc|nccl'; then \
      echo "ERROR: LibTorch archive at $LIBTORCH_URL contains CUDA libraries" >&2; \
      exit 1; \
    fi; \
    printf 'variant=%s\nversion=%s\nabi=%s\n' \
      "$LIBTORCH_VARIANT" "$LIBTORCH_VERSION" "$LIBTORCH_ABI" \
      > /space/lib/libtorch/.hexmesh-variant

# ---------------------------------------------------------------------------
# Stage 2 (build): compiler + dev packages, then compile evocube + hex.
# Also the self-contained devel image.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /space

# Same dev packages as Dockerfile.build's build stage, minus everything CUDA,
# plus: libvulkan-dev (loader + headers, replacing the LunarG SDK) and
# mesa-vulkan-drivers + vulkan-tools so this stage can prove Vulkan actually
# works on a CPU device before anything is compiled against it.
# libhdf5-serial-dev is a transitional package for libhdf5-dev on 22.04.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git cmake build-essential patch python3 python3-pip \
      libblas-dev liblapack-dev libgl1-mesa-dev \
      libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
      libhdf5-dev libvulkan-dev \
      mesa-vulkan-drivers vulkan-tools \
 && rm -rf /var/lib/apt/lists/*

# --- libraries (extracted in stage 1, without the raw archive) ---
COPY --from=libs /space/lib /space/lib

# Software Vulkan (lavapipe). No NVIDIA ICD exists in this image, and no
# VULKAN_SDK* variables are set: the loader and the validation-layer-absent
# fallback in vkoo/src/core/Instance.cpp handle it.
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json
ENV LD_LIBRARY_PATH=/space/lib/libtorch/lib

# Fail the build here, not six minutes into a pipeline run, if the software ICD
# is not actually usable.
RUN vulkaninfo --summary 2>/dev/null | grep -qi 'llvmpipe\|lavapipe' \
 && echo "OK: software Vulkan (lavapipe/llvmpipe) is available"

# --- source from the build context (NOT bind-mounted), same layout as /space ---
COPY evocube/                  /space/evocube/
COPY interactive-hex-meshing/  /space/interactive-hex-meshing/
COPY compile.sh                /space/compile.sh
COPY cli_run/                  /space/cli_run/
COPY patches/                  /space/patches/

# HEX_CPU_ONLY makes compile.sh skip the Vulkan SDK sourcing (system Vulkan is
# already on the default paths) and pass -DHEX_ENABLE_CUDA=OFF.
ENV HEX_CPU_ONLY=1

RUN bash /space/compile.sh \
 && test -x /space/evocube/build/polycube_withHexEx \
 && test -x /space/interactive-hex-meshing/bin/Release/hex \
 && echo "OK: evocube + hex binaries built (CPU-only)"

# Belt-and-braces: the binary this image just produced must not link CUDA.
RUN if ldd /space/interactive-hex-meshing/bin/Release/hex \
      | grep -Eiq 'cuda|nvidia|cudnn|nvrtc|cupti|cusolver'; then \
      echo "ERROR: CPU-only build linked a CUDA library" >&2; exit 1; \
    fi; \
    echo "OK: hex links no CUDA library"

# Declare what this image is, so cli_run/run.sh, ./hex and run_docker.sh assemble
# CPU-variant arguments when they run *inside* it. Without this they default to
# cuda and reject the CPU binary via the bin/Release/.hexmesh-variant guard.
ENV HEX_IMAGE_VARIANT=cpu

RUN mkdir -p /space/output

CMD ["/bin/bash"]

# ---------------------------------------------------------------------------
# Stage 3 (runtime): SLIM image — binaries + their shared libs + assets and the
# CLI scripts. No compilers, no source, no build trees, no LibTorch headers.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /space

# Runtime equivalents of the build stage's -dev packages. `file` and
# vulkan-tools are here for the diagnostic checks in plans/cpu-only-build.md
# (Verification B invokes file, Verification D invokes vulkaninfo); they can be
# dropped from a later production-slim target once those move to a test image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libblas3 liblapack3 libgomp1 libhdf5-103 libhdf5-cpp-103 \
      libgl1 libglu1-mesa libgl1-mesa-dri \
      libxrandr2 libxinerama1 libxcursor1 libxi6 \
      libvulkan1 mesa-vulkan-drivers \
      file vulkan-tools \
 && rm -rf /var/lib/apt/lists/*

# LibTorch runtime .so's only — no headers, no CMake configs, no static libs.
COPY --from=build /space/lib/libtorch/lib               /space/lib/libtorch/lib
COPY --from=build /space/lib/libtorch/.hexmesh-variant  /space/lib/libtorch/.hexmesh-variant

COPY --from=build /space/interactive-hex-meshing/bin          /space/interactive-hex-meshing/bin
COPY --from=build /space/interactive-hex-meshing/assets       /space/interactive-hex-meshing/assets
COPY --from=build /space/interactive-hex-meshing/vkoo/shaders /space/interactive-hex-meshing/vkoo/shaders
COPY --from=build /space/evocube/build                        /space/evocube/build
COPY --from=build /space/cli_run                              /space/cli_run

ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json
ENV LD_LIBRARY_PATH=/space/lib/libtorch/lib
ENV HEX_IMAGE_VARIANT=cpu

RUN mkdir -p /space/output

CMD ["/bin/bash"]
